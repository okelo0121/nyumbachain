# =========================================================
# NyumbaChain — Root Environment Variables (EXAMPLE ONLY)
# Copy to .env and fill in real values. NEVER commit .env
# =========================================================

# --- Database ---
DATABASE_URL=postgresql://nyumba:nyumba@localhost:5432/nyumbachain

# --- Auth ---
JWT_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_SERVICE_SECRET=S_REPLACE_WITH_BACKEND_SERVICE_SECRET
USDC_CONTRACT_ADDRESS=C_BNZLHWXWE3VTS42XZ3KOCG7XWY4QK5UE7XKHG6B7E5F4X

# --- Cloudflare R2 (file storage) ---
CLOUDFLARE_R2_ACCESS_KEY=replace_me
CLOUDFLARE_R2_SECRET_KEY=replace_me
CLOUDFLARE_R2_BUCKET=nyumbachain-photos
CLOUDFLARE_R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://photos.nyumbachain.com

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@nyumbachain.com

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:replace_me@us1-something.upstash.io:6379

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
